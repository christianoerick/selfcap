#. Plugin Name of the plugin
#: selfcap.php
msgid "Selfcap – Self-Hosted Captcha"
msgstr "Selfcap – Captcha auto-hospedado"

#. Plugin URI of the plugin
#: selfcap.php
msgid "https://github.com/christianoerick/selfcap"
msgstr "https://github.com/christianoerick/selfcap"

#. Description of the plugin
#: selfcap.php
msgid "A privacy-friendly captcha that runs entirely inside your WordPress site: a checkbox widget backed by proof-of-work, with no third-party service and no external server."
msgstr "Um captcha que respeita a privacidade e roda inteiro dentro do seu site WordPress: uma caixa de seleção apoiada em prova de trabalho, sem serviço de terceiros e sem servidor externo."

#. Author of the plugin
#: selfcap.php
msgid "Christiano Erick"
msgstr "Christiano Erick"

