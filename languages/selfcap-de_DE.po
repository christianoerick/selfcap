#. Plugin Name of the plugin
#: selfcap.php
msgid "Selfcap – Self-Hosted Captcha"
msgstr "Selfcap – Selbst gehostetes Captcha"

#. Plugin URI of the plugin
#: selfcap.php
msgid "https://github.com/christianoerick/selfcap"
msgstr "https://github.com/christianoerick/selfcap"

#. Description of the plugin
#: selfcap.php
msgid "A privacy-friendly captcha that runs entirely inside your WordPress site: a checkbox widget backed by proof-of-work, with no third-party service and no external server."
msgstr "Ein datenschutzfreundliches Captcha, das vollständig innerhalb Ihrer WordPress-Website läuft: ein Kontrollkästchen-Widget auf Basis von Proof-of-Work, ohne Drittanbieterdienst und ohne externen Server."

#. Author of the plugin
#: selfcap.php
msgid "Christiano Erick"
msgstr "Christiano Erick"

