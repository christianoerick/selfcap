#. Plugin Name of the plugin
#: selfcap.php
msgid "Selfcap – Self-Hosted Captcha"
msgstr "Selfcap – Captcha autoalojado"

#. Plugin URI of the plugin
#: selfcap.php
msgid "https://github.com/christianoerick/selfcap"
msgstr "https://github.com/christianoerick/selfcap"

#. Description of the plugin
#: selfcap.php
msgid "A privacy-friendly captcha that runs entirely inside your WordPress site: a checkbox widget backed by proof-of-work, with no third-party service and no external server."
msgstr "Un captcha respetuoso con la privacidad que funciona por completo dentro de tu sitio WordPress: una casilla de verificación respaldada por prueba de trabajo, sin servicios de terceros y sin servidor externo."

#. Author of the plugin
#: selfcap.php
msgid "Christiano Erick"
msgstr "Christiano Erick"

